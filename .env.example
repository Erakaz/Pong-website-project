# =============================================================================
#  ft_transcendence — modele de configuration
#
#  Copier ce fichier en `.env` puis remplacer TOUTES les valeurs `change-me`.
#  Le fichier `.env` est ignore par git (voir .gitignore) et ne doit JAMAIS
#  etre commite : le sujet sanctionne la publication de credentials par un
#  echec du projet.
#
#      cp .env.example .env
#      make secrets      # genere des secrets aleatoires solides
# =============================================================================

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-run-make-secrets
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend

# Origine publique du site. Sert aux redirections OAuth, aux cookies et a la
# verification Origin des WebSockets. Doit correspondre au port publie par
# nginx dans docker-compose.yml.
SITE_ORIGIN=https://localhost:8443

# --- Ports publies --------------------------------------------------------
# Ports > 1024 obligatoires : sur les machines 42, Docker tourne en mode
# rootless et ne peut pas binder les ports privilegies.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- JWT ------------------------------------------------------------------
JWT_SECRET=change-me-run-make-secrets
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=1209600     # 14 jours

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me-run-make-secrets
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- OAuth 2.0 42 (module optionnel) --------------------------------------
# Laisser vide desactive proprement le module : le bouton « Se connecter avec
# 42 » est masque et les routes renvoient 503. Rien d'autre ne change.
# Creer l'application sur https://profile.intra.42.fr/oauth/applications
# avec exactement cette redirect URI.
OAUTH42_UID=
OAUTH42_SECRET=
OAUTH42_REDIRECT_URI=https://localhost:8443/api/auth/oauth42/callback
